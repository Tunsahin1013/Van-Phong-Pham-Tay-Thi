# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (default 3000)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/stationery_shop)
# REQUIRED: MongoDB Atlas is the only application database. No JSON fallback is available.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taythi?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taythi?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Password recovery email (optional for local dev; required to deliver recovery emails in production)
RESEND_API_KEY=""
EMAIL_FROM="Tay Thi <no-reply@example.com>"
